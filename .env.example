# ---------------------------------------------------------------------------
# Smart Plant Emergency Detector — Environment Variables
# Copy to .env and fill in real values. Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- API server ---
API_HOST=0.0.0.0
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (SQLite) ---
DATABASE_FILE=./infra/data/smartplant.db

# --- Auth / JWT ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Internal service-to-service auth (Mosquitto <-> API) ---
INTERNAL_MQTT_SHARED_SECRET=change-me-internal-shared-secret

# --- MQTT broker (Mosquitto) ---
MQTT_URL=mqtt://localhost:1883
MQTT_BRIDGE_USERNAME=api-bridge
MQTT_BRIDGE_PASSWORD=change-me-bridge-password

# --- Mailer (dev: writes links to log instead of sending email) ---
MAIL_FROM="Smart Plant <no-reply@smartplant.local>"
MAIL_DRIVER=dev

# --- Firebase Cloud Messaging (push notifications) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=change-me-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=change-me-telegram-webhook-secret
TELEGRAM_WEBHOOK_URL=https://api.yourdomain.com/api/v1/integrations/telegram/webhook
# Set to "polling" for local dev (no public URL needed) or "webhook" for production.
TELEGRAM_MODE=polling

# --- Observability ---
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_DSN_MOBILE=

# --- Web app (Next.js public vars) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws
